---
import "../styles/main.css";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";

interface Props {
    title: string;
    header?: boolean;
}

const { title, header = true } = Astro.props;

const documentTitle = title ? title + " | aedm" : "aedm";
---

<!doctype html>
<html lang="es">
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-BKX38RNZGX"
    ></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
            dataLayer.push(arguments);
        }
        gtag("js", new Date());

        gtag("config", "G-BKX38RNZGX");
    </script>

    <script is:inline>
        // Modo app decidido antes de pintar (sin parpadeo): marca <html> y el
        // CSS (main.css) oculta cabecera, footer y aviso de cookies desde el
        // primer frame. Se activa con el user-agent de ASO.app o ?app
        // (cualquier valor salvo "0"/"false", p. ej. ?app, ?app=1).
        (function () {
            var appParam = new URLSearchParams(window.location.search).get(
                "app",
            );
            var isAppParam =
                appParam !== null &&
                appParam !== "0" &&
                appParam.toLowerCase() !== "false";
            var isApp =
                isAppParam ||
                navigator.userAgent.indexOf("ASO.app 2") !== -1;
            if (isApp) {
                document.documentElement.setAttribute("data-app", "true");
            }
        })();
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
    />
    <title>{documentTitle}</title>

    <body>
        <div id="aso-chrome">
            <NavBar />
        </div>
        <!--- <div id="errInfo">
            <p>
                Ahora mismo tenemos un problema con el servidor físico ubicado
                en la ESD. Algunas páginas no se cargan correctamente.
            </p>
        </div> -->

        <main>
            {header && <h1>{title}</h1>}
            <slot />
        </main>

        <div id="aso-chrome-footer" style="width:100%;align-self:stretch;">
            <Footer />
        </div>

        <!-- Cookie consent banner -->
        <div id="cookie-banner" role="dialog" aria-live="polite">
            <p>
                Este sitio web utiliza cookies y Google Analytics para mejorar
                su experiencia. Al continuar navegando, acepta el uso de estas
                tecnologías.
            </p>
            <button id="cookie-accept">Aceptar</button>
        </div>

        <script>
            // Modo app: lo decide el script inline del <head>, que marca
            // <html data-app="true"> y el CSS oculta el chrome sin parpadeo.
            // Aquí solo leemos esa marca.
            const appParam = new URLSearchParams(window.location.search).get(
                "app",
            );
            const isAppParam =
                appParam !== null &&
                appParam !== "0" &&
                appParam.toLowerCase() !== "false";
            const isAsoApp =
                document.documentElement.getAttribute("data-app") === "true";

            if (isAsoApp) {
                const appValue = isAppParam ? appParam || "1" : "1";

                // Todos los enlaces abren en pestaña nueva y, si son internos,
                // arrastran ?app para que la nueva pestaña siga en modo app.
                // Excepción: los chips de Expone-Solicita (?expone=...), que
                // navegan en la misma pestaña para rellenar el formulario.
                const processLinks = () => {
                    document.querySelectorAll("a[href]").forEach((anchor) => {
                        if (anchor.dataset.appLink === "1") return;

                        const raw = anchor.getAttribute("href") ?? "";
                        if (
                            !raw ||
                            raw.startsWith("#") ||
                            raw.startsWith("javascript:")
                        ) {
                            return;
                        }
                        anchor.dataset.appLink = "1";

                        const isChip =
                            anchor.classList.contains("chip") ||
                            raw.startsWith("?");

                        let url: URL;
                        try {
                            url = new URL(raw, window.location.href);
                        } catch {
                            return;
                        }

                        if (url.origin === window.location.origin) {
                            url.searchParams.set("app", appValue);
                            anchor.setAttribute("href", url.toString());
                        }

                        if (isChip) return;

                        anchor.setAttribute("target", "_blank");
                        anchor.setAttribute("rel", "noopener noreferrer");
                    });
                };

                processLinks();
                new MutationObserver(processLinks).observe(document.body, {
                    childList: true,
                    subtree: true,
                });
            } else {
                // Cookie consent logic
                const banner = document.getElementById("cookie-banner");
                const acceptBtn = document.getElementById("cookie-accept");

                const COOKIE_NAME = "cookieConsent";

                function getCookie(name: string): string | null {
                    const match = document.cookie
                        .split("; ")
                        .find((row) => row.startsWith(name + "="));
                    return match ? match.split("=")[1] : null;
                }

                function setCookie(name: string, value: string, days: number) {
                    const expires = new Date(
                        Date.now() + days * 864e5,
                    ).toUTCString();
                    document.cookie = `${name}=${value}; expires=${expires}; path=/; SameSite=Lax`;
                }

                // Only show banner if consent not yet given
                if (banner) {
                    if (getCookie(COOKIE_NAME) === "true") {
                        banner.style.display = "none";
                    } else {
                        banner.style.display = "flex";
                    }
                }

                acceptBtn?.addEventListener("click", () => {
                    setCookie(COOKIE_NAME, "true", 365);
                    if (banner) banner.style.display = "none";
                    loadAnalytics();
                });

                // If already accepted on a previous visit, load immediately
                if (getCookie(COOKIE_NAME) === "true") {
                    loadAnalytics();
                }
            }

            function loadAnalytics() {
                console.log("cookieok");
            }
            console.log("aedm.astro GC3");
        </script>
    </body>
</html>

<style>
    #errInfo {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 99999;
        background: var(--rojo);
        color: #fff;
        padding: 2px 20px;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    #errInfo p {
        margin: 0;
        font-size: 14px;
        color: #fff;
        flex: 1;
    }

    #cookie-banner {
        display: none; /* shown via JS only if needed */
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 99999;
        background: #2b373b;
        color: #fff;
        padding: 14px 20px;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
    }

    #cookie-banner p {
        margin: 0;
        font-size: 14px;
        color: #fff;
        flex: 1;
    }

    #cookie-accept {
        background: rgb(54, 228, 82);
        color: #000;
        border: none;
        padding: 8px 18px;
        font-size: 14px;
        cursor: pointer;
        white-space: nowrap;
        flex-shrink: 0;
    }

    #cookie-accept:hover {
        opacity: 0.85;
    }
</style>

<script>
    const errInfo = document.getElementById("errInfo");

    if (errInfo) {
        errInfo.onclick = () => {
            errInfo.style.display = "none";
        };
    }
</script>
