---
import { link } from "../lib/paths";

const redirect = link("/info");
---

<meta refresh={`0; url=${redirect}`} />
<h1>308 - Permanent Redirect</h1>
<ul>
    <li><a href={redirect}>Click here to go to the page</a></li>
</ul>
<script>
    window.onload = function () {
        window.location.href = import.meta.env.BASE_URL + "info";
    };
</script>
