---
import Default from "../../layouts/Default.astro";
import NotionPage from "../../components/NotionPage.astro";
import { discoverPageIds, fetchNotionPage } from "../../lib/notion";

export async function getStaticPaths() {
    const ids = await discoverPageIds();
    return ids.map((id) => ({ params: { id } }));
}

const id = Astro.params.id ?? "";

const result = id ? await fetchNotionPage(id) : null;
const page = result && result.ok ? result.page : null;

const title = page ? page.current_page_title : "Página";
---

<Default title={title} header={false}>
    <NotionPage pageId={id} page={page ?? undefined} />
</Default>
