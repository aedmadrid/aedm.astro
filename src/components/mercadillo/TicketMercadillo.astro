---
import "../../styles/main.css";
import { edicion } from "../../data/mercadillo";

interface Props {
    nombre?: string;
    fecha?: string;
    horario?: string;
    lugar?: string;
}

const {
    nombre = edicion.nombre,
    fecha = edicion.fecha,
    horario = edicion.horario,
    lugar = edicion.lugar,
} = Astro.props;

const MESES: Record<string, string> = {
    enero: "ene",
    febrero: "feb",
    marzo: "mar",
    abril: "abr",
    mayo: "may",
    junio: "jun",
    julio: "jul",
    agosto: "ago",
    septiembre: "sep",
    octubre: "oct",
    noviembre: "nov",
    diciembre: "dic",
};

// "viernes 18 de diciembre" -> "18 dic" para la pestaña del ticket.
const fechaCorta = (() => {
    const match = fecha.match(/(\d{1,2})\s+de\s+([a-záéíóú]+)/i);
    if (!match) return fecha;
    const mes = MESES[match[2].toLowerCase()] ?? match[2].slice(0, 3);
    return `${match[1]} ${mes}`;
})();
---

<div
    class="ticket"
    aria-label={`${nombre}: ${fecha}, ${horario}, ${lugar}`}
>
    <div class="ticket__main">
        <p class="ticket__eyebrow">{nombre}</p>
        <p class="ticket__fecha">{fecha}</p>
        <p class="ticket__detalle">{horario}</p>
        <p class="ticket__detalle">{lugar}</p>
    </div>
    <div class="ticket__stub" aria-hidden="true">
        <span class="material-symbols-outlined">confirmation_number</span>
        <span class="ticket__stub-label">{fechaCorta}</span>
        <strong>{edicion.year}</strong>
    </div>
</div>

<style>
    .ticket {
        position: relative;
        display: flex;
        flex-direction: column;
        width: min(100%, 360px);
        margin: 4px auto 8px;
        background: var(--blanco);
        border: 1px solid var(--gris2);
        color: var(--negro);
    }

    .ticket__main {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 24px 22px 20px;
    }

    .ticket__eyebrow {
        margin: 0;
        color: var(--gris4);
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.12em;
        line-height: 1.35;
        text-transform: uppercase;
    }

    .ticket__fecha {
        margin: 0;
        font-family: TitleFont, serif;
        font-size: 38px;
        line-height: 1;
    }

    .ticket__fecha::first-letter {
        text-transform: uppercase;
    }

    .ticket__detalle {
        margin: 0;
        color: var(--gris5);
        font-size: 14px;
        line-height: 1.35;
    }

    .ticket__detalle + .ticket__detalle {
        margin-top: -2px;
        color: var(--gris4);
        font-size: 13px;
    }

    .ticket__stub {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 12px 16px;
        border-top: 1px dashed var(--gris3);
        background: var(--verde);
        color: var(--negro);
        white-space: nowrap;
    }

    .ticket__stub::before,
    .ticket__stub::after {
        content: "";
        position: absolute;
        top: -8px;
        width: 15px;
        height: 15px;
        border-radius: 50%;
        background: var(--blanco);
    }

    .ticket__stub::before {
        left: -8px;
    }

    .ticket__stub::after {
        right: -8px;
    }

    .ticket__stub .material-symbols-outlined {
        font-size: 20px;
        color: inherit;
    }

    .ticket__stub-label {
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .ticket__stub strong {
        font-family: TitleFont, serif;
        font-size: 20px;
        font-weight: 400;
        line-height: 1;
    }

    @media (max-width: 600px) {
        .ticket {
            width: min(100%, 320px);
        }

        .ticket__main {
            padding: 18px 16px 16px;
        }

        .ticket__fecha {
            font-size: 31px;
        }

        .ticket__detalle {
            font-size: 13px;
        }

        .ticket__stub {
            padding: 10px 12px;
        }
    }
</style>
