---
import GranBoton from "./GranBoton.astro";
import HClick from "./HClick.astro";
import Boton from "./Boton.astro";
import NotionBlocks from "./NotionBlocks.astro";
import { link } from "../lib/paths";
import { pageIdFromHref } from "../lib/notion";
import "../styles/main.css";

interface RichTextAnnotations {
    bold?: boolean;
    italic?: boolean;
    underline?: boolean;
    strikethrough?: boolean;
    code?: boolean;
    color?: string;
}

interface RichTextItem {
    plain_text: string;
    href?: string | null;
    annotations?: RichTextAnnotations;
}

interface NotionBlock {
    id: string;
    type:
        | "paragraph"
        | "heading_1"
        | "heading_2"
        | "heading_3"
        | "bulleted_list_item"
        | "numbered_list_item"
        | "to_do"
        | "quote"
        | "bookmark"
        | "code"
        | "divider"
        | "embed"
        | "child_page"
        | "image"
        | "video"
        | "file"
        | "table"
        | "column_list"
        | "column"
        | "toggle"
        | "callout";
    rich_text?: RichTextItem[];
    checked?: boolean;
    url?: string;
    proxy_url?: string;
    title?: string;
    caption?: RichTextItem[];
    language?: string;
    icon?: string;
    color?: string;
    width_ratio?: number;
    table_width?: number;
    has_column_header?: boolean;
    has_row_header?: boolean;
    rows?: TableRow[];
    columns?: ColumnData[];
    children?: NotionBlock[];
}

interface TableRow {
    id: string;
    cells: RichTextItem[][];
}

interface ColumnData {
    id: string;
    width_ratio?: number;
    blocks: NotionBlock[];
}

interface Props {
    blocks: NotionBlock[];
    /** Host del API que sirvió la página (para las URLs de ficheros). */
    apiBase?: string;
    depth?: number;
}

const { blocks, apiBase = "", depth = 0 } = Astro.props;

/**
 * URL estable de un fichero de Notion. Las URLs directas de Notion caducan a
 * la hora, así que se usa el proxy del API (/media/<blockId>).
 */
function mediaUrl(block: NotionBlock): string {
    if (block.proxy_url) return `${apiBase}${block.proxy_url}`;
    return block.url ?? "";
}

const COLOR_HEX: Record<string, string> = {
    gray: "#9B9A97",
    brown: "#7B4B25",
    orange: "#D9730D",
    yellow: "#DFAB01",
    green: "#0F7B6C",
    blue: "#0B6E99",
    purple: "#6940A5",
    pink: "#AD1A72",
    red: "#E03E3E",
};

const COLOR_BG_HEX: Record<string, string> = {
    gray: "#F1F1EF",
    brown: "#F4E6D4",
    orange: "#FEEEDA",
    yellow: "#FEF3C0",
    green: "#DDEDEA",
    blue: "#DDEBF1",
    purple: "#EAE4F2",
    pink: "#FBE4F0",
    red: "#FDEBEC",
};

function getColorStyle(color?: string): string {
    if (!color || color === "default") return "";
    if (color.endsWith("_background")) {
        const base = color.replace("_background", "");
        const bg = COLOR_BG_HEX[base] ?? COLOR_BG_HEX.gray;
        const fg = COLOR_HEX[base] ?? "#202020";
        return `background-color:${bg};color:${fg};`;
    }
    return `color:${COLOR_HEX[color] ?? color};`;
}

function richTextToHtml(items: RichTextItem[] = []): string {
    if (!items.length) return "&nbsp;";
    return items
        .map((item) => {
            const styles: string[] = [];
            if (item.annotations?.bold) styles.push("font-weight:600");
            if (item.annotations?.italic) styles.push("font-style:italic");
            const textDec: string[] = [];
            if (item.annotations?.underline) textDec.push("underline");
            if (item.annotations?.strikethrough) textDec.push("line-through");
            if (textDec.length)
                styles.push(`text-decoration:${textDec.join(" ")}`);
            const colorStyle = getColorStyle(item.annotations?.color);
            if (colorStyle) styles.push(colorStyle);

            const styleAttr = styles.length
                ? ` style="${styles.join(";")}"`
                : "";
            const content = item.plain_text || "\u00A0";
            const escaped = content
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;");

            if (item.href) {
                const pageId = pageIdFromHref(item.href);
                if (pageId) {
                    return `<a href="${link(`/id/${pageId}`)}"${styleAttr}>${escaped}</a>`;
                }
                const href = link(item.href);
                if (/^https?:/i.test(href)) {
                    return `<a href="${href}"${styleAttr} target="_blank" rel="noreferrer">${escaped}</a>`;
                }
                return `<a href="${href}"${styleAttr}>${escaped}</a>`;
            }
            return `<span${styleAttr}>${escaped}</span>`;
        })
        .join("");
}

function getPlainText(items: RichTextItem[] = []): string {
    return items.map((i) => i.plain_text).join("");
}

// Group consecutive list items into lists
type SingleGroup = { type: "single"; block: NotionBlock };
type ListGroup = {
    type: "list";
    listType: "bulleted" | "numbered";
    blocks: NotionBlock[];
};
type BlockGroup = SingleGroup | ListGroup;

const groups: BlockGroup[] = [];
let i = 0;
while (i < blocks.length) {
    const block = blocks[i];

    if (
        block.type === "bulleted_list_item" ||
        block.type === "numbered_list_item"
    ) {
        const listType =
            block.type === "numbered_list_item" ? "numbered" : "bulleted";
        const items: NotionBlock[] = [];
        while (i < blocks.length && blocks[i].type === block.type) {
            items.push(blocks[i]);
            i++;
        }
        groups.push({ type: "list", listType, blocks: items });
    } else {
        groups.push({ type: "single", block });
        i++;
    }
}
---

{blocks.length === 0 && <p>La página no contiene contenido.</p>}

{
    groups.map((group) => {
        if (group.type === "list") {
            if (group.listType === "numbered") {
                return (
                    <ol class="notion-block numbered-list">
                        {group.blocks.map((item) => (
                            <li class="notion-block numbered-list-item">
                                <span set:html={richTextToHtml(item.rich_text)} />
                                {item.children && item.children.length > 0 && (
                                    <NotionBlocks
                                        blocks={item.children}
                                        apiBase={apiBase}
                                        depth={depth + 1}
                                    />
                                )}
                            </li>
                        ))}
                    </ol>
                );
            }

            return (
                <ul class="notion-block bulleted-list">
                    {group.blocks.map((item) => (
                        <li class="notion-block bulleted-list-item">
                            <span set:html={richTextToHtml(item.rich_text)} />
                            {item.children && item.children.length > 0 && (
                                <NotionBlocks
                                    blocks={item.children}
                                    apiBase={apiBase}
                                    depth={depth + 1}
                                />
                            )}
                        </li>
                    ))}
                </ul>
            );
        }

        const block = group.block;

        if (block.type === "paragraph") {
            if (block.children && block.children.length > 0) {
                return (
                    <div class="notion-block paragraph">
                        <span set:html={richTextToHtml(block.rich_text)} />
                        <NotionBlocks
                            blocks={block.children}
                            apiBase={apiBase}
                            depth={depth + 1}
                        />
                    </div>
                );
            }
            return (
                <p
                    class="notion-block paragraph"
                    set:html={richTextToHtml(block.rich_text)}
                />
            );
        }

        if (block.type === "heading_1") {
            return (
                <h1
                    class="notion-block heading-1"
                    set:html={richTextToHtml(block.rich_text)}
                />
            );
        }

        if (block.type === "heading_2") {
            const rt = block.rich_text ?? [];
            if (rt.length === 1 && rt[0].href) {
                return (
                    <div class="notion-block heading-2">
                        <GranBoton
                            texto={rt[0].plain_text || rt[0].href || ""}
                            url={rt[0].href || "#"}
                            icono="arrow_outward"
                            orden={0}
                        />
                    </div>
                );
            }
            return (
                <h2
                    class="notion-block heading-2"
                    set:html={richTextToHtml(block.rich_text)}
                />
            );
        }

        if (block.type === "heading_3") {
            return (
                <h3
                    class="notion-block heading-3"
                    set:html={richTextToHtml(block.rich_text)}
                />
            );
        }

        if (block.type === "to_do") {
            return (
                <label class="notion-block todo-item">
                    <input type="checkbox" checked={!!block.checked} disabled />
                    <span set:html={richTextToHtml(block.rich_text)} />
                </label>
            );
        }

        if (block.type === "quote") {
            return (
                <blockquote
                    class="notion-block quote"
                    set:html={richTextToHtml(block.rich_text)}
                />
            );
        }

        if (block.type === "bookmark") {
            return (
                <div class="notion-block bookmark">
                    <Boton texto={block.url ?? ""} url={block.url ?? "#"} />
                </div>
            );
        }

        if (block.type === "code") {
            return (
                <pre class="notion-block code-block">
                    <code data-language={block.language}>
                        {getPlainText(block.rich_text)}
                    </code>
                </pre>
            );
        }

        if (block.type === "divider") {
            return <hr class="notion-block divider" />;
        }

        if (block.type === "embed") {
            return (
                <div class="notion-block embed">
                    <iframe
                        src={block.url}
                        title={`embed-${block.id}`}
                        loading="lazy"
                        allowfullscreen
                        style="width:100%;min-height:200px;border:0;"
                    />
                </div>
            );
        }

        if (block.type === "child_page") {
            return (
                <div class="notion-block child-page">
                    <HClick
                        texto={block.title || ""}
                        enlace={`/id/${block.id}`}
                        icono="arrow_forward"
                    />
                </div>
            );
        }

        if (block.type === "image") {
            return (
                <figure class="notion-block image">
                    <img
                        src={mediaUrl(block)}
                        alt={getPlainText(block.caption)}
                        loading="lazy"
                        decoding="async"
                        style="max-width:100%;"
                    />
                    {block.caption && block.caption.length > 0 && (
                        <figcaption set:html={richTextToHtml(block.caption)} />
                    )}
                </figure>
            );
        }

        if (block.type === "video") {
            const src = mediaUrl(block);
            const isEmbed = /youtube\.com|youtu\.be|vimeo\.com/i.test(src);
            return (
                <figure class="notion-block video">
                    {isEmbed ? (
                        <iframe
                            src={src.replace("watch?v=", "embed/")}
                            title={`video-${block.id}`}
                            loading="lazy"
                            allowfullscreen
                            style="width:100%;aspect-ratio:16/9;border:0;"
                        />
                    ) : (
                        <video
                            src={src}
                            controls
                            playsinline
                            preload="metadata"
                            style="max-width:100%;"
                        />
                    )}
                    {block.caption && block.caption.length > 0 && (
                        <figcaption set:html={richTextToHtml(block.caption)} />
                    )}
                </figure>
            );
        }

        if (block.type === "file") {
            const name =
                getPlainText(block.caption) ||
                decodeURIComponent(mediaUrl(block).split("/").pop() || "Archivo");
            const href = block.proxy_url
                ? `${apiBase}${block.proxy_url}`
                : block.url ?? "#";
            return (
                <div class="notion-block file">
                    <a href={href} download rel="noreferrer">
                        {name}
                    </a>
                </div>
            );
        }

        if (block.type === "table") {
            const rows = block.rows ?? [];
            if (rows.length === 0) return null;

            const hasColHeader = !!block.has_column_header;
            const hasRowHeader = !!block.has_row_header;
            const headRow = hasColHeader ? rows[0] : null;
            const bodyRows = hasColHeader ? rows.slice(1) : rows;

            return (
                <div class="notion-block table-wrap">
                    <table class="notion-table">
                        {headRow && (
                            <thead>
                                <tr>
                                    {headRow.cells.map((cell) => (
                                        <th
                                            scope="col"
                                            set:html={richTextToHtml(cell)}
                                        />
                                    ))}
                                </tr>
                            </thead>
                        )}
                        <tbody>
                            {bodyRows.map((row) => (
                                <tr>
                                    {row.cells.map((cell, index) =>
                                        hasRowHeader && index === 0 ? (
                                            <th
                                                scope="row"
                                                set:html={richTextToHtml(cell)}
                                            />
                                        ) : (
                                            <td set:html={richTextToHtml(cell)} />
                                        ),
                                    )}
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            );
        }

        if (block.type === "column_list") {
            const columns = block.columns ?? [];
            if (columns.length === 0) return null;

            const template = columns
                .map((col) => `${col.width_ratio || 1}fr`)
                .join(" ");

            return (
                <div
                    class="notion-block columns"
                    style={`grid-template-columns:${template}`}
                >
                    {columns.map((col) => (
                        <div class="notion-col">
                            <NotionBlocks
                                blocks={col.blocks}
                                apiBase={apiBase}
                                depth={depth + 1}
                            />
                        </div>
                    ))}
                </div>
            );
        }

        if (block.type === "toggle") {
            return (
                <details
                    class="notion-block toggle"
                    style={getColorStyle(block.color)}
                >
                    <summary set:html={richTextToHtml(block.rich_text)} />
                    {block.children && block.children.length > 0 && (
                        <div class="toggle-content">
                            <NotionBlocks
                                blocks={block.children}
                                apiBase={apiBase}
                                depth={depth + 1}
                            />
                        </div>
                    )}
                </details>
            );
        }

        if (block.type === "callout") {
            const icon = block.icon ?? "";
            const isIconUrl = /^https?:/i.test(icon);
            return (
                <div
                    class="notion-block callout"
                    style={getColorStyle(block.color)}
                >
                    {icon && (
                        <span class="callout-icon">
                            {isIconUrl ? (
                                <img src={icon} alt="" loading="lazy" />
                            ) : (
                                icon
                            )}
                        </span>
                    )}
                    <div class="callout-body">
                        {block.rich_text && block.rich_text.length > 0 && (
                            <p set:html={richTextToHtml(block.rich_text)} />
                        )}
                        {block.children && block.children.length > 0 && (
                            <NotionBlocks
                                blocks={block.children}
                                apiBase={apiBase}
                                depth={depth + 1}
                            />
                        )}
                    </div>
                </div>
            );
        }

        return null;
    })
}

<style>
    :global(.notion-block.paragraph) {
        margin: 0.25em 0;
    }

    :global(.notion-block.heading-1) {
        margin: 1em 0 0.5em;
    }

    :global(.notion-block.heading-2) {
        margin: 0.8em 0 0.4em;
    }

    :global(.notion-block.heading-3) {
        margin: 0.6em 0 0.3em;
    }

    :global(.notion-block.quote) {
        border-left: 3px solid var(--verde, #36e452);
        padding-left: 1em;
        margin: 1em 0;
        font-style: italic;
    }

    :global(.notion-block.bulleted-list) {
        margin: 0.5em 0;
        padding-left: 1.5em;
    }

    :global(.notion-block.bulleted-list-item) {
        margin: 0.2em 0;
    }

    :global(.notion-block.numbered-list) {
        margin: 0.5em 0;
        padding-left: 1.5em;
        list-style-type: decimal;
    }

    :global(.notion-block.numbered-list-item) {
        margin: 0.2em 0;
    }

    :global(.notion-block.todo-item) {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0.3em 0;
    }

    :global(.notion-block.code-block) {
        background: #f5f5f5;
        padding: 1em;
        border-radius: 4px;
        overflow-x: auto;
        margin: 1em 0;
    }

    :global(.notion-block.code-block code) {
        font-family: monospace;
        font-size: 14px;
    }

    :global(.notion-block.divider) {
        border: none;
        border-top: 1px solid #e0e0e0;
        margin: 1.5em 0;
    }

    :global(.notion-block.embed) {
        margin: 1em 0;
    }

    :global(.notion-block.image) {
        margin: 1em 0;
    }

    :global(.notion-block.image figcaption) {
        font-size: 0.85em;
        color: #666;
        margin-top: 0.5em;
        text-align: center;
    }

    :global(.notion-block.bookmark) {
        margin: 0.5em 0;
    }

    :global(.notion-block.child-page) {
        margin: 0.5em 0;
    }

    :global(.notion-block.table-wrap) {
        margin: 1em 0;
        overflow-x: auto;
    }

    :global(.notion-block .notion-table) {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.95em;
    }

    :global(.notion-block .notion-table th),
    :global(.notion-block .notion-table td) {
        border: 1px solid #e0e0e0;
        padding: 8px 12px;
        text-align: left;
        vertical-align: top;
    }

    :global(.notion-block .notion-table thead th) {
        background: #f7f7f5;
        font-weight: 600;
    }

    :global(.notion-block .notion-table tbody th) {
        font-weight: 600;
        background: #fbfbfa;
        white-space: nowrap;
    }

    :global(.notion-block.columns) {
        display: grid;
        gap: 24px;
        margin: 1em 0;
        align-items: start;
    }

    :global(.notion-block.columns .notion-col) {
        min-width: 0;
    }

    @media (max-width: 720px) {
        :global(.notion-block.columns) {
            grid-template-columns: 1fr !important;
            gap: 12px;
        }
    }

    :global(.notion-block.toggle) {
        margin: 0.4em 0;
    }

    :global(.notion-block.toggle > summary) {
        cursor: pointer;
        padding: 2px 0;
    }

    :global(.notion-block.toggle .toggle-content) {
        padding-left: 1.2em;
    }

    :global(.notion-block.callout) {
        display: flex;
        gap: 12px;
        padding: 12px 14px;
        margin: 1em 0;
        border: 1px solid #e6e6e6;
        background: #f7f7f5;
    }

    :global(.notion-block.callout .callout-icon) {
        flex: 0 0 auto;
        font-size: 1.1em;
        line-height: 1.4;
    }

    :global(.notion-block.callout .callout-icon img) {
        width: 18px;
        height: 18px;
        object-fit: contain;
    }

    :global(.notion-block.callout .callout-body) {
        flex: 1 1 auto;
        min-width: 0;
    }

    :global(.notion-block.callout .callout-body p) {
        margin: 0;
    }

    :global(.notion-block.video) {
        margin: 1em 0;
    }

    :global(.notion-block.file) {
        margin: 0.6em 0;
    }
</style>
