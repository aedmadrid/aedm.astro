---
import "../styles/main.css";
import { link } from "../lib/paths";

const { texto, url, tipo } = Astro.props;

type tiposDeTipo = "verde" | "negro" | "outline";

interface Props {
    texto: string;
    url: string;
    tipo?: tiposDeTipo;
}

const href = link(url);
const target = href.startsWith("http") ? "_blank" : "_self";
---

<a href={href} target={target}
    ><button class={tipo || "verde"}> {texto} </button></a
>

<style>
    button {
        border: 0;
        width: 100%;
        cursor: pointer;
        font-size: 16px;
        padding: 10px;
        font-weight: 400;
    }
    .verde {
        background-color: var(--verde);
    }
    .negro {
        background-color: var(--negro);
        color: var(--blanco);
    }
    .outline {
        background-color: transparent;
        border: 1px solid var(--verde);
        color: var(--verde);
    }
</style>
