---
import Pic from "./Pic.astro";

interface Pantalla {
    src: string;
    alt: string;
}

const pantallas: Pantalla[] = [
    { src: "/img/app/escuela.jpeg", alt: "Pantalla de Escuela de la ASO.app" },
    { src: "/img/app/aedm.jpeg", alt: "Pantalla de AEDM de la ASO.app" },
    {
        src: "/img/app/cafe-cultura.jpeg",
        alt: "Artículo Café y Cultura en la ASO.app",
    },
    { src: "/img/app/inicio.jpeg", alt: "Pantalla de inicio de la ASO.app" },
    {
        src: "/img/app/correo.jpeg",
        alt: "Pantalla de Correo de EducaMadrid de la ASO.app",
    },
    { src: "/img/app/ajustes.jpeg", alt: "Pantalla de Ajustes de la ASO.app" },
    {
        src: "/img/app/software.jpeg",
        alt: "Pantalla de Software Alumnos de la ASO.app",
    },
];

const centro = 3;
const copias = 5;
const N = pantallas.length;
const lista = Array.from({ length: copias }, () => pantallas).flat();
const inicioReal = Math.floor(copias / 2) * N;
const indiceCentro = inicioReal + centro;
---

<section
    class="carrusel"
    aria-label="Pantallas de la ASO.app"
    data-n={N}
    data-centro={indiceCentro}
>
    <div class="carrusel-track">
        {
            lista.map((pantalla, i) => {
                const clon = i < inicioReal || i >= inicioReal + N;
                return (
                    <figure
                        class="pantalla"
                        aria-hidden={clon ? "true" : undefined}
                    >
                        <Pic
                            src={pantalla.src}
                            alt={pantalla.alt}
                            loading={i === indiceCentro ? "eager" : "lazy"}
                            draggable="false"
                        />
                    </figure>
                );
            })
        }
    </div>
</section>

<style>
    .carrusel {
        --pw: clamp(180px, 44vw, 260px);
        width: 100vw;
        max-width: 100vw;
        margin-left: calc(-50vw + 50%);
        margin-right: calc(-50vw + 50%);
        padding: 10px 0 0;
        overflow: hidden;
    }

    .carrusel-track {
        display: flex;
        align-items: flex-start;
        gap: clamp(6px, 2vw, 22px);
        overflow-x: auto;
        overflow-y: hidden;
        padding: 40px calc(50% - var(--pw) / 2) 30px;
        perspective: 1400px;
        perspective-origin: 50% 35%;
        scroll-snap-type: x mandatory;
        scroll-behavior: smooth;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        cursor: grab;
        touch-action: pan-y;
        user-select: none;
        -webkit-tap-highlight-color: transparent;
    }

    .carrusel-track::-webkit-scrollbar {
        display: none;
    }

    .carrusel-track.dragging {
        cursor: grabbing;
        scroll-snap-type: none;
        scroll-behavior: auto;
    }

    .pantalla {
        flex: 0 0 auto;
        width: var(--pw);
        margin: 0;
        scroll-snap-align: center;
        transform-origin: center center;
        will-change: transform, opacity;
        transition:
            transform 0.25s ease,
            opacity 0.25s ease;
    }

    .pantalla img {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 22px;
        border: 1px solid rgba(0, 0, 0, 0.06);
        background: var(--blanco);
        box-shadow: 0 34px 60px -18px rgba(0, 0, 0, 0.45);
        -webkit-user-drag: none;
        user-select: none;
        pointer-events: none;
    }

    @media (prefers-reduced-motion: reduce) {
        .pantalla {
            transition: none;
        }
    }
</style>

<script>
    const section = document.querySelector<HTMLElement>(".carrusel");
    const track = section?.querySelector<HTMLElement>(".carrusel-track");
    const items = track
        ? Array.from(track.querySelectorAll<HTMLElement>(".pantalla"))
        : [];
    const N = Number(section?.dataset.n ?? 0);
    const centroIdx = Number(section?.dataset.centro ?? 0);
    const centroEl = items[centroIdx];

    if (track && centroEl && N > 0) {
        let period = 0;
        let down = false;

        const computePeriod = () => {
            period = items[N].offsetLeft - items[0].offsetLeft;
        };

        const update = () => {
            const c = track.scrollLeft + track.clientWidth / 2;
            const span = Math.max(track.clientWidth * 0.72, 1);

            for (const el of items) {
                const mid = el.offsetLeft + el.offsetWidth / 2;
                let t = (mid - c) / span;
                t = Math.max(-1.35, Math.min(1.35, t));
                const a = Math.min(Math.abs(t), 1);

                el.style.transform = `translateY(${a * 46}px) rotateY(${-t * 40}deg) scale(${1 - a * 0.24})`;
                el.style.opacity = String(1 - a * 0.45);
                el.style.zIndex = String(100 - Math.round(a * 90));
            }
        };

        const normalize = () => {
            if (!period) return;
            if (track.scrollLeft < period) track.scrollLeft += period;
            else if (track.scrollLeft > 4 * period) track.scrollLeft -= period;
        };

        let raf = 0;
        const schedule = () => {
            if (raf) return;
            raf = requestAnimationFrame(() => {
                raf = 0;
                if (!down) normalize();
                update();
            });
        };

        const centrarInicio = () => {
            const prev = track.style.scrollBehavior;
            track.style.scrollBehavior = "auto";
            track.scrollLeft =
                centroEl.offsetLeft +
                centroEl.offsetWidth / 2 -
                track.clientWidth / 2;
            track.style.scrollBehavior = prev;
            computePeriod();
            normalize();
            update();
        };

        track.addEventListener("scroll", schedule, { passive: true });

        centrarInicio();
        requestAnimationFrame(centrarInicio);
        window.addEventListener("load", centrarInicio);

        const ro = new ResizeObserver(() => {
            computePeriod();
            normalize();
            update();
        });
        ro.observe(track);

        let startX = 0;
        let startY = 0;
        let startScroll = 0;
        let pending = false;

        const beginDrag = () => {
            down = true;
            pending = false;
            track.classList.add("dragging");
        };

        track.addEventListener("pointerdown", (e) => {
            if (e.pointerType === "mouse" && e.button !== 0) return;
            startX = e.clientX;
            startY = e.clientY;
            startScroll = track.scrollLeft;
            if (e.pointerType === "mouse") {
                beginDrag();
            } else {
                pending = true;
            }
        });

        window.addEventListener("pointermove", (e) => {
            if (pending) {
                const dx = e.clientX - startX;
                const dy = e.clientY - startY;
                if (Math.abs(dx) > 6 && Math.abs(dx) > Math.abs(dy)) {
                    startX = e.clientX;
                    startScroll = track.scrollLeft;
                    beginDrag();
                } else if (Math.abs(dy) > 6) {
                    pending = false;
                    return;
                }
            }
            if (!down) return;
            track.scrollLeft = startScroll - (e.clientX - startX);
        });

        const endDrag = () => {
            pending = false;
            if (!down) return;
            down = false;
            track.classList.remove("dragging");
            normalize();
            update();
        };

        window.addEventListener("pointerup", endDrag);
        window.addEventListener("pointercancel", endDrag);
    }
</script>
